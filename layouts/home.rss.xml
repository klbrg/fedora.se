{{- $pages := where site.RegularPages "Section" "in" (slice "guider") -}}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"><channel>
<title>fedora.se</title>
<link>{{ site.Home.Permalink }}</link>
<description>Svenska guider och nyheter om Fedora Linux</description>
{{ range $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><description>{{ .Params.description }}</description><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate></item>
{{ end }}</channel></rss>
